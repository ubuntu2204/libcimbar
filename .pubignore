# .pubignore — files excluded from the published package.
#
# IMPORTANT: when a package has a `.pubignore`, pub no longer consults
# `.gitignore`, so every rule needed for publishing must live in this file.

# ====================
# Vendored C++ sources
# ====================
# `third_party/libcimbar` IS published: the build hook compiles the native
# library from it, and shipping the sources also satisfies the MPL-2.0
# "source availability" obligation.
#
# `third_party/cfc` stays out: it is a reference implementation we never build
# against, and it embeds a SECOND copy of the libcimbar sources (roughly half
# of the vendored tree).
third_party/cfc/

# ====================
# Dart / Flutter tooling
# ====================
.dart_tool/
**/.dart_tool/
.pub-cache/
.pub/
.packages
pubspec.lock
**/pubspec.lock
build/
coverage/
doc/api/
.flutter-plugins
.flutter-plugins-dependencies

# ====================
# Native build output
# ====================
native/build_linux/
native/build_wasm/
native/build_windows/
native/build_android/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exp
*.pdb
*.ilk

# ...but the PREBUILT binaries we ship are not build output — re-include them:
#   Android: android/src/main/jniLibs/<abi>/libcimbar_jni.so  (Gradle merges
#            them into the APK, so users don't need the NDK/CMake at all)
#   Windows: windows/libcimbar.dll (copied next to the .exe by windows/CMakeLists)
!android/src/main/jniLibs/**/*.so
!windows/*.dll

# ====================
# Android
# ====================
android/local.properties
android/.gradle/
android/.cxx/
android/.externalNativeBuild/
**/.gradle/
*.apk
*.aab
*.jks
*.keystore
*.iml

# ====================
# WASM artifacts (built separately via native/build_wasm.sh)
# ====================
# The copy in `assets/wasm/` IS published (Flutter asset, loaded by the web
# decoder); the per-app copies are duplicates and stay out.
*.wasm
!assets/wasm/*.wasm
example/web/assets/wasm/
decode_example/web/assets/wasm/
test/wasm/.build/

# ====================
# Local test artifacts / media
# ====================
*.mp4
*.log

# ====================
# IDE / editor / OS
# ====================
.idea/
.vscode/
.codebuddy/
.DS_Store
*.swp
